# ==============================================================================
# AI TRADING SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Configuration:
# - Di Docker / Linux: otomatis memakai PostgreSQL jika POSTGRES_HOST di-set (default di docker-compose: db)
# - Di Windows / Local tanpa Docker: otomatis memakai SQLite (ai_trading.db) jika DATABASE_URL dan POSTGRES_HOST kosong
# - Opsi kustom: Anda bisa menyetel DATABASE_URL secara eksplisit (PostgreSQL / SQLite)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_trading
# DATABASE_URL=sqlite:///./ai_trading.db

# Parameter PostgreSQL (opsional jika menggunakan PostgreSQL):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=ai_trading
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# MT5 Bridge URL (jika menggunakan mt5_bridge.py untuk fetch data / history):
# MT5_BRIDGE_URL=http://127.0.0.1:8001

# Direktori Data Strategy Lab (opsional, default: ./lab-data di local, /app/lab-data di Docker):
# LAB_DATA_DIR=./lab-data

# Gemini AI API Key (opsional, jika ingin mengaktifkan live AI market analyst):
# GEMINI_API_KEY=your_api_key_here
